# ============================================================
# SmartGoNext Salon Backend - Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Environment Mode
#   development -> Flask dev server (single-threaded)
#   production  -> Waitress production server (single-threaded)
# ------------------------------------------------------------
ENVIRONMENT=development

# Server Port
PORT=5000

# ------------------------------------------------------------
# SINGLE-THREAD MODE (DEFAULT = true)
# One thread handles ALL users sequentially.
# Set to false only if you intentionally want multi-threading.
# ------------------------------------------------------------
SINGLE_THREAD=true
THREADS=1

# ------------------------------------------------------------
# AUTO-SLEEP MODE (DEFAULT = enabled)
# After AUTO_SLEEP_MINUTES of NO API requests, the backend
# process kills itself (all threads die) to save resources.
# systemd auto-restarts it on the next incoming request.
# ------------------------------------------------------------
AUTO_SLEEP_ENABLED=true
AUTO_SLEEP_MINUTES=5
AUTO_SLEEP_CHECK_INTERVAL=30

# Database Configuration
# SQLite:   sqlite:///parlour.db
# MySQL:    mysql+pymysql://username:password@host/db_name
# The database is AUTO-CREATED on startup if it does not exist.
# Production example:
#   DATABASE_URL=mysql+pymysql://smartgo1_salon_user:password@localhost:3306/smartgo1_salon
DATABASE_URL=mysql+pymysql://smartgo1_salon_user:password@localhost:3306/smartgo1_salon

# Flask Configuration
SECRET_KEY=dev-secret-key-123!
JWT_SECRET_KEY=jwt-dev-secret-key-123!-change-this-in-production-32chars

# CORS Configuration
# Add your production frontend domain:
#   CORS_ORIGINS=https://salon.smartgonext.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://salon.smartgonext.com
CORS_ALLOW_ALL=false

# RESET DATABASE (DANGEROUS - drops all tables and re-creates fresh)
# Set to true ONLY once if your database schema is corrupted.
# After the app starts successfully, set it back to false.
RESET_DATABASE=false

# WhatsApp Meta API Configuration (Optional)
WHATSAPP_PERMANENT_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=